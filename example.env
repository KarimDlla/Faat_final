# Provider order: openai first, then gemini. Reverse to gemini,openai if needed.
AI_PROVIDER_ORDER=openai,gemini
AI_TIMEOUT_MS=30000
AI_MAX_REQUESTS_PER_MINUTE=20

# OpenAI
OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna
# Optional model fallbacks
# OPENAI_MODEL_FALLBACK_1=gpt-6-sol
# OPENAI_MODEL_FALLBACK_2=gpt-5.6-sol

# Gemini
GEMINI_API_KEY=put-your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional model fallbacks
# GEMINI_MODEL_FALLBACK_1=gemini-3.7-flash
# GEMINI_MODEL_FALLBACK_2=gemini-3.6-flash
GEMINI_FALLBACK_CONCURRENCY=2

# Optional: OpenAI gets its own timeout (reading a PDF with a reasoning model often needs more than 30s)
# OPENAI_TIMEOUT_MS=90000
